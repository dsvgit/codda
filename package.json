{
  "name": "codda-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/codda"
  ],
  "scripts": {
    "dev": "npm run dev -w codda --",
    "build": "npm run build -w codda --",
    "preview": "npm run preview -w codda --",
    "typecheck": "npm run typecheck -w codda && tsc -p tsconfig.json",
    "test": "npm test -w codda --",
    "build:deps": "npm run build:deps -w codda",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  }
}

{
  // The CLI runs in Node 24 as TypeScript, without a build step. vite.config.ts
  // runs in Node too and imports the CLI's Course reader.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [".", "../vite.config.ts"]
}
